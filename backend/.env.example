# Server port (default 5000)
PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/student-wellness
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/student-wellness?retryWrites=true&w=majority
#        (get the full URI from Atlas: Cluster → Connect → Connect your application → Node.js)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/student-wellness?retryWrites=true&w=majority

# Secret for signing JWT tokens (use a long random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Optional: JWT expiry (e.g. 7d, 24h)
JWT_EXPIRE=7d

# Optional: frontend URL for CORS (e.g. http://localhost:5173)
FRONTEND_URL=http://localhost:5173
